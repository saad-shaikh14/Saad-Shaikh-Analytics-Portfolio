---
// Direction B, "Drawn systems": a navy band where the diagram language carries the identity. The name and role sit
// beside a simple overview, so the first screen shows both the person and the kind of work.
import ConceptLayout from '../../../layouts/ConceptLayout.astro';
import CdcOverview from '../../../components/concepts/CdcOverview.astro';
import { LINKS } from '../../../data/site';
import { url } from '../../../utils/url';
---

<ConceptLayout title="Direction B: Drawn systems" label="Direction B, Drawn systems" tone="navy" current="home">
  <section class="b-band" aria-labelledby="b-title">
    <div class="container-wide b-hero">
      <div class="b-hero__text">
        <p class="b-eyebrow">Data Engineering · Data Platform Architecture · AI</p>
        <h1 id="b-title">I'm Saad Shaikh. I build and run data platforms, and I draw them so they can be checked.</h1>
        <p class="b-sub">
          Every diagram here comes from the documentation it cites, with its assumptions written down. I'm a data engineer
          in London, working with Snowflake, dbt and AWS.
        </p>
        <p class="b-actions">
          <a class="b-primary" href={url('/concepts/cdc/')}>See the first blueprint</a>
          <a class="b-secondary" href={url('/concepts/about/')}>About me</a>
        </p>
      </div>
      <div class="b-hero__figure">
        <CdcOverview compact headingId="b-ov" />
      </div>
    </div>
  </section>

  <section class="container-wide b-explore" aria-labelledby="b-explore-title">
    <h2 id="b-explore-title">Explore by area</h2>
    <div class="b-cards">
      <a class="b-card" href={url('/concepts/cdc/')}>
        <span class="b-card__kicker">Data engineering</span>
        <span class="b-card__title">Log-based change data capture into a warehouse</span>
        <span class="b-card__text">Why changes arrive twice, and the merge that makes it harmless.</span>
      </a>
      <a class="b-card" href={url('/concepts/architecture/')}>
        <span class="b-card__kicker">Data platform architecture</span>
        <span class="b-card__title">The architecture library</span>
        <span class="b-card__text">Reference blueprints drawn from cited documentation, starting with CDC.</span>
      </a>
      <a class="b-card" href={url('/concepts/about/#now')}>
        <span class="b-card__kicker">AI</span>
        <span class="b-card__title">AI agents on data systems</span>
        <span class="b-card__text">What I'm exploring: what agents can safely do, and what still needs a person.</span>
      </a>
    </div>
  </section>

  <section class="container-wide b-person" aria-labelledby="b-person-title">
    <h2 id="b-person-title">About me, briefly</h2>
    <p>
      I started in market research and data analysis, writing Python to automate reporting, and moved into building the
      platforms underneath it. Today I work on change data capture, warehouse modelling, orchestration and
      infrastructure as code. I studied data science at the University of Hertfordshire.
    </p>
    <p>
      <a class="text-link" href={url('/concepts/about/')}>More about me</a>
      <span aria-hidden="true"> · </span>
      <a class="text-link" href={LINKS.linkedin.href} rel="me">Connect on LinkedIn</a>
    </p>
  </section>
</ConceptLayout>

<style>
  .b-band {
    background: var(--c-navy);
    color: var(--c-surface);
  }

  .b-hero {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-7);
    align-items: center;
    padding-block: var(--s-8);
  }

  .b-eyebrow {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f4c7a8;
    margin: 0 0 var(--s-4);
  }

  .b-hero h1 {
    color: var(--c-surface);
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
    line-height: 1.1;
    margin: 0 0 var(--s-5);
  }

  .b-sub {
    color: #dfe6ee;
    font-size: var(--step-1);
    margin: 0;
  }

  .b-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin: var(--s-6) 0 0;
  }

  .b-primary,
  .b-secondary {
    display: inline-block;
    padding: 0.75rem 1.2rem;
    border-radius: var(--radius-small);
    font-weight: 700;
    text-decoration: none;
  }

  .b-primary {
    background: var(--c-surface);
    color: var(--c-navy);
  }

  .b-secondary {
    color: var(--c-surface);
    border: 1.5px solid #dfe6ee;
  }

  .b-primary:hover,
  .b-secondary:hover {
    color: var(--c-copper-deep);
    background: var(--c-surface);
  }

  .b-band :focus-visible {
    outline-color: #f4c7a8;
  }

  .b-explore,
  .b-person {
    padding-block: var(--s-7);
  }

  .b-person {
    border-top: 1px solid var(--c-rule);
    max-width: 84rem;
  }

  .b-person p {
    max-width: 64ch;
  }

  .b-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .b-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-rule);
    border-top: 4px solid var(--c-navy);
    border-radius: var(--radius);
    color: var(--c-ink);
    text-decoration: none;
  }

  .b-card:hover {
    border-top-color: var(--c-copper);
    color: var(--c-ink);
  }

  .b-card__kicker {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--c-graphite);
  }

  .b-card__title {
    font-family: var(--f-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
  }

  .b-card__text {
    color: var(--c-graphite);
  }

  @media (max-width: 64rem) {
    .b-hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 56rem) {
    .b-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
