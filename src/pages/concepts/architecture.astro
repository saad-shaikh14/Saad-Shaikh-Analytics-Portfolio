---
// Architecture landing, concept: lead with the one real entry as a visual cover and the reader's problem;
// the four entry types and the method move into a short note at the end.
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import CdcOverview from '../../components/concepts/CdcOverview.astro';
import { url } from '../../utils/url';
---

<ConceptLayout title="Architecture library" label="shared page for A, B and C" current="architecture">
  <section class="container-wide arch-intro" aria-labelledby="arch-title">
    <p class="eyebrow">Architecture library</p>
    <h1 id="arch-title">Data systems, drawn so they can be checked</h1>
    <p class="lede">
      Each entry takes one data-platform problem, draws a design that solves it, and lists the documentation behind
      every box and arrow.
    </p>
  </section>

  <section class="container-wide arch-cover" aria-labelledby="arch-cover-title">
    <div class="arch-cover__text">
      <p class="arch-cover__type">Reference blueprint · Data engineering</p>
      <h2 id="arch-cover-title">
        <a href={url('/concepts/cdc/')}>Log-based change data capture into an analytical warehouse</a>
      </h2>
      <p class="arch-cover__problem">
        <strong>The problem:</strong> keep warehouse tables in step with a live database without querying it on a timer,
        when a restart can send the same changes twice.
      </p>
      <p><strong>You'll come away with:</strong></p>
      <ul>
        <li>the shape that works, in one picture;</li>
        <li>why duplicates happen, and the merge that makes them harmless;</li>
        <li>what to watch once it is running.</li>
      </ul>
      <a class="text-link" href={url('/concepts/cdc/')}>Read the blueprint</a>
    </div>
    <CdcOverview headingId="arch-ov" />
  </section>

  <section class="container-wide arch-note" aria-labelledby="arch-note-title">
    <h2 id="arch-note-title">About these entries</h2>
    <p>
      Entries are reference designs with their assumptions stated, not diagrams of any real deployment. Each one lists
      its sources, and says where a claim is my analysis rather than documented. As the library grows, entries will be
      grouped as blueprints, design decisions, patterns and visual explainers.
    </p>
  </section>
</ConceptLayout>

<style>
  .arch-intro {
    padding-block: var(--s-8) var(--s-5);
  }

  .arch-intro h1 {
    margin: 0 0 var(--s-4);
    max-width: 20ch;
  }

  .arch-cover {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--s-7);
    align-items: start;
    padding-block: var(--s-6);
  }

  .arch-cover__type {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--c-navy);
    margin: 0 0 var(--s-2);
  }

  .arch-cover h2 {
    margin: 0 0 var(--s-4);
  }

  .arch-cover h2 a {
    color: var(--c-ink);
    text-decoration: none;
  }

  .arch-cover h2 a:hover {
    color: var(--c-copper);
  }

  .arch-cover__problem {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .arch-cover ul {
    padding-left: 1.2em;
  }

  .arch-note {
    padding-block: var(--s-6);
    border-top: 1px solid var(--c-rule);
    color: var(--c-graphite);
  }

  .arch-note h2 {
    font-size: var(--step-1);
  }

  .arch-note p {
    max-width: 68ch;
  }

  @media (max-width: 64rem) {
    .arch-cover {
      grid-template-columns: 1fr;
    }
  }
</style>
