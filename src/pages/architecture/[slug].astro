---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import PageBanner from '../../components/PageBanner.astro';
import { ARCHITECTURE_TYPES, SITE } from '../../data/site';
import { formatDate, isoDate, publishedArchitecture, readingMinutes } from '../../utils/content';
import { absoluteUrl, url } from '../../utils/url';

export async function getStaticPaths() {
  const entries = await publishedArchitecture();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const type = ARCHITECTURE_TYPES[entry.data.architectureType];
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingMinutes(entry.body);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: isoDate(entry.data.publicationDate),
    dateModified: isoDate(entry.data.lastReviewed),
    author: { '@type': 'Person', name: SITE.author, url: absoluteUrl('/about/') },
    mainEntityOfPage: absoluteUrl(`/architecture/${entry.id}/`),
    inLanguage: SITE.lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Architecture', item: absoluteUrl('/architecture/') },
      { '@type': 'ListItem', position: 2, name: entry.data.title },
    ],
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.publicationDate}
  modifiedTime={entry.data.lastReviewed}
  jsonLd={jsonLd}
>
  <article class="entry">
    <PageBanner title={entry.data.title} eyebrow={type.label} crumbs={[['Architecture', '/architecture/'], [type.label]]}>
      <p>{entry.data.summary}</p>
      <ul class="entry__meta">
        <li>
          Published <time datetime={isoDate(entry.data.publicationDate)}>{formatDate(entry.data.publicationDate)}</time>
        </li>
        <li>
          Last reviewed <time datetime={isoDate(entry.data.lastReviewed)}>{formatDate(entry.data.lastReviewed)}</time>
        </li>
        <li>{minutes} min read</li>
      </ul>
    </PageBanner>

    <div class="container-wide entry__intro">
      <section class="assumptions" aria-labelledby="assumptions-title">
        <h2 id="assumptions-title">Scope and assumptions</h2>
        <ul>
          {entry.data.assumptions.map((a) => <li>{a}</li>)}
        </ul>
        <p class="assumptions__note">{type.blurb}</p>
      </section>
      {
        toc.length > 2 && (
          <nav class="toc" aria-labelledby="toc-title">
            <h2 id="toc-title">On this page</h2>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </div>
    <div class="container-wide prose entry__content">
      <Content />
      <SourceList sources={entry.data.sources} />
    </div>
  </article>
</BaseLayout>

<style>
  .entry__meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-5);
    margin: var(--s-5) 0 0;
    padding: 0;
    font-size: var(--step--1);
    color: #dfe6ee;
  }

  .entry__intro {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s-6);
    align-items: start;
    margin-bottom: var(--s-6);
    font-size: 0.95rem;
  }

  .entry__content {
    max-width: none;
  }

  .entry__content > :global(*:not(figure):not(pre)) {
    max-width: var(--measure);
  }

  .entry__content > :global(pre) {
    max-width: min(100%, 96ch);
  }

  .assumptions {
    background: var(--c-parchment);
    border-radius: var(--radius);
    padding: var(--s-5);
  }

  .assumptions h2,
  .toc h2 {
    font-size: var(--step-0);
    font-family: var(--f-body);
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0 0 var(--s-3);
  }

  .assumptions ul {
    margin: 0;
    padding-left: 1.2em;
  }

  .assumptions li + li {
    margin-top: var(--s-2);
  }

  .assumptions__note {
    margin: var(--s-4) 0 0;
    font-size: var(--step--1);
    color: var(--c-graphite);
  }

  .toc {
    border-left: 2px solid var(--c-rule-strong);
    padding-left: var(--s-5);
  }

  .toc ol {
    margin: 0;
    padding-left: 1.2em;
  }

  .toc li + li {
    margin-top: var(--s-2);
  }

  .toc a {
    display: inline-block;
    padding-block: 0.15rem;
  }

  @media (max-width: 56rem) {
    .entry__intro {
      grid-template-columns: 1fr;
    }
  }
</style>
