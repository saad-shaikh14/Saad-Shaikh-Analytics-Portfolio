---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import PageBanner from '../../components/PageBanner.astro';
import { ARCHITECTURE_TYPES } from '../../data/site';
import { publishedArchitecture } from '../../utils/content';
import { url } from '../../utils/url';

const entries = await publishedArchitecture();
---

<BaseLayout
  title="Architecture"
  description="A library of reference architectures, architecture decisions, engineering patterns and visual explainers for modern data platforms, each built from cited sources."
>
  <PageBanner title="Architecture" eyebrow="Architecture library" crumbs={[['Architecture']]}>
    <p>
      Diagrams and explanations of how data platforms fit together and how they fail. Every figure is drawn from cited
      documentation and reviewed before it is published. Reference architectures describe a possible design, not a
      specific deployment.
    </p>
  </PageBanner>

  <section class="section container-wide entries" aria-labelledby="entries-title">
    <h2 id="entries-title">Entries</h2>
    {
      entries.map((e) => (
        <EntryCard
          href={url(`/architecture/${e.id}/`)}
          title={e.data.title}
          summary={e.data.summary}
          kicker={ARCHITECTURE_TYPES[e.data.architectureType].label}
          date={e.data.publicationDate}
        />
      ))
    }
  </section>

  <section class="tint" aria-labelledby="formats-title">
    <div class="container-wide formats">
    <h2 id="formats-title">Kinds of entry</h2>
    <dl class="formats__list">
      {
        Object.values(ARCHITECTURE_TYPES).map((t) => (
          <div class="formats__item">
            <dt>{t.label}</dt>
            <dd>{t.blurb}</dd>
          </div>
        ))
      }
    </dl>
    </div>
  </section>

</BaseLayout>

<style>
  .tint {
    background: var(--c-parchment);
    margin-top: var(--s-7);
  }

  .formats {
    padding-block: var(--s-7);
  }

  .formats__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
    margin: 0;
    padding: var(--s-4) 0 0;
  }

  .formats__item {
    border-left: 2px solid var(--c-rule-strong);
    padding-left: var(--s-4);
  }

  .formats__item dt {
    font-weight: 700;
    margin-bottom: var(--s-2);
  }

  .formats__item dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--c-graphite);
  }

  .entries h2 {
    font-size: var(--step-2);
  }

  @media (max-width: 64rem) {
    .formats__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .formats__list {
      grid-template-columns: 1fr;
    }
  }
</style>
