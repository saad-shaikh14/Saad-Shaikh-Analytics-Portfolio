---
import { LINKS, NAV, SITE } from '../data/site';
import { publishedArchitecture } from '../utils/content';
import { url } from '../utils/url';

const year = new Date().getUTCFullYear();
const entries = await publishedArchitecture();
---

<footer class="site-footer">
  <div class="container-wide">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__name">{SITE.name}</p>
        <p class="site-footer__bio">
          Data engineer in London. Reference architectures for data platforms, drawn from cited documentation, with their
          trade-offs stated.
        </p>
      </div>
      <nav aria-label="Footer: topics">
        <h2 class="site-footer__title">Topics</h2>
        <ul>
          {SITE.areas.map((a) => <li>{a}</li>)}
        </ul>
        {
          entries.length > 0 && (
            <ul class="site-footer__entries">
              {entries.map((e) => (
                <li>
                  <a href={url(`/architecture/${e.id}/`)}>{e.data.title}</a>
                </li>
              ))}
            </ul>
          )
        }
      </nav>
      <nav aria-label="Footer: pages">
        <h2 class="site-footer__title">Pages</h2>
        <ul>
          {NAV.map((item) => <li><a href={url(item.path)}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="site-footer__title">Connect</h2>
        <ul>
          <li><a href={LINKS.linkedin.href} rel="me">{LINKS.linkedin.label}</a></li>
          <li><a href={LINKS.github.href} rel="me">{LINKS.github.label}</a></li>
          <li><a href={url('/rss.xml')}>RSS feed</a></li>
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom">
      <p>© {year} {SITE.name}. Diagrams and text are original unless a source is cited.</p>
      <p>{SITE.areas.join(' · ')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-8);
    background: var(--c-navy);
    color: #dfe6ee;
    padding-top: var(--s-8);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 2fr 1.4fr 1fr 1fr;
    gap: var(--s-6);
    padding-bottom: var(--s-7);
  }

  .site-footer__name {
    font-family: var(--f-display);
    font-weight: 650;
    font-size: 1.3rem;
    color: var(--c-surface);
    margin: 0 0 var(--s-3);
  }

  .site-footer__bio {
    margin: 0;
    max-width: 38ch;
  }

  .site-footer__title {
    font-family: var(--f-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f4c7a8;
    margin: 0 0 var(--s-3);
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer li + li {
    margin-top: var(--s-1);
  }

  .site-footer a {
    display: inline-block;
    padding-block: 0.3rem;
    color: #dfe6ee;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--c-surface);
    text-decoration: underline;
  }

  .site-footer :focus-visible {
    outline-color: #f4c7a8;
  }

  .site-footer__entries {
    margin-top: var(--s-3) !important;
    font-size: var(--step--1);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-5);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-size: var(--step--1);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (max-width: 56rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
