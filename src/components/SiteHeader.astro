---
import { NAV, SITE } from '../data/site';
import { isCurrent, url } from '../utils/url';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__name">{SITE.name}</span>{' '}
      <span class="brand__subtitle">{SITE.subtitle}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {
          NAV.map((item) => {
            const current = isCurrent(here, item.path);
            return (
              <li>
                <a href={url(item.path)} aria-current={current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--c-rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    flex-wrap: wrap;
    padding-block: var(--s-4);
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--c-ink);
    padding-block: var(--s-1);
  }

  .brand__name {
    font-family: var(--f-display);
    font-size: 1.35rem;
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .brand__subtitle {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-graphite);
  }

  .nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    margin: 0;
    padding: 0;
  }

  .nav a {
    display: inline-block;
    min-height: 2.75rem;
    padding: 0.6rem 0.1rem;
    color: var(--c-ink);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .nav a:hover {
    color: var(--c-copper);
  }

  .nav a[aria-current='page'] {
    border-bottom-color: var(--c-copper);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .nav {
      gap: var(--s-1) var(--s-4);
    }
  }
</style>
